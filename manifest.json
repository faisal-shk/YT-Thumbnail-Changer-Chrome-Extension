{
    "manifest_version": 3,
    "name": "Youtube Thumbnail Changer",
    "version": "1.0.0",
    "icons": {
        "48": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/"],
            "js": ["Content.js"]
        }
    ]
}